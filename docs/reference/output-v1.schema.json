{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/GregoryGelfond/elenctic/v1.1.0/docs/reference/output-v1.schema.json",
  "title": "elenctic output schema 1",
  "type": "object",
  "required": [
    "schema",
    "exit_code"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "why": {
      "oneOf": [
        {
          "$ref": "#/$defs/explanation"
        },
        {
          "$ref": "#/$defs/warrant"
        },
        {
          "$ref": "#/$defs/these"
        },
        {
          "$ref": "#/$defs/not_these"
        },
        {
          "$ref": "#/$defs/no_assumptions"
        },
        {
          "$ref": "#/$defs/ended"
        },
        {
          "$ref": "#/$defs/fault"
        },
        {
          "$ref": "#/$defs/internal"
        }
      ]
    },
    "ask": {
      "oneOf": [
        {
          "$ref": "#/$defs/answered"
        },
        {
          "$ref": "#/$defs/these"
        },
        {
          "$ref": "#/$defs/not_these"
        },
        {
          "$ref": "#/$defs/no_assumptions"
        },
        {
          "$ref": "#/$defs/ended"
        },
        {
          "$ref": "#/$defs/fault"
        },
        {
          "$ref": "#/$defs/internal"
        }
      ]
    },
    "exit_code": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3
      ],
      "description": "The status the command exits with: the Exit of a test run, or the WhyExit or AskExit of a question (0, 1, 2, or 3)."
    }
  },
  "oneOf": [
    {
      "required": [
        "run"
      ]
    },
    {
      "required": [
        "why"
      ]
    },
    {
      "required": [
        "ask"
      ]
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "aggregate": {
      "type": "object",
      "required": [
        "kind",
        "rule",
        "substitution",
        "instance",
        "atom",
        "value",
        "guard"
      ],
      "properties": {
        "kind": {
          "const": "aggregate"
        },
        "rule": {
          "$ref": "#/$defs/rule"
        },
        "substitution": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "atom": {
          "type": "string"
        },
        "value": {
          "type": "integer"
        },
        "guard": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "all": {
      "type": "object",
      "required": [
        "kind",
        "parts"
      ],
      "properties": {
        "kind": {
          "const": "all"
        },
        "parts": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/not"
              },
              {
                "$ref": "#/$defs/all"
              },
              {
                "$ref": "#/$defs/any"
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "answer_set": {
      "type": "object",
      "required": [
        "kind",
        "atoms",
        "shown",
        "assignment",
        "cost"
      ],
      "properties": {
        "kind": {
          "const": "answer_set"
        },
        "atoms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shown": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assignment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/valuation"
          }
        },
        "cost": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false
    },
    "answered": {
      "type": "object",
      "required": [
        "kind",
        "query",
        "over",
        "answer",
        "taken",
        "read",
        "unreached",
        "mode",
        "cut"
      ],
      "properties": {
        "kind": {
          "const": "answered"
        },
        "query": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/not"
            },
            {
              "$ref": "#/$defs/all"
            },
            {
              "$ref": "#/$defs/any"
            }
          ]
        },
        "over": {
          "type": "string",
          "enum": [
            "all",
            "optimal"
          ]
        },
        "answer": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unknown",
                "not_entailed",
                "none_holds"
              ]
            },
            {
              "$ref": "#/$defs/answers"
            }
          ]
        },
        "taken": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taken"
          }
        },
        "read": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "unreached": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unreached"
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "default",
            "cautious",
            "brave"
          ]
        },
        "cut": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "max_answer_sets",
                "max_seconds",
                "interrupted"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "lints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "additionalProperties": false
    },
    "answers": {
      "type": "object",
      "required": [
        "kind",
        "variables",
        "bound",
        "answer_sets"
      ],
      "properties": {
        "kind": {
          "const": "answers"
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bound": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bound"
          }
        },
        "answer_sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/numbered"
          }
        }
      },
      "additionalProperties": false
    },
    "any": {
      "type": "object",
      "required": [
        "kind",
        "parts"
      ],
      "properties": {
        "kind": {
          "const": "any"
        },
        "parts": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/not"
              },
              {
                "$ref": "#/$defs/all"
              },
              {
                "$ref": "#/$defs/any"
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "asks": {
      "type": "object",
      "required": [
        "kind",
        "answer",
        "query",
        "over"
      ],
      "properties": {
        "kind": {
          "const": "asks"
        },
        "answer": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown",
            "not_entailed",
            "none_holds"
          ]
        },
        "query": {
          "$ref": "#/$defs/all"
        },
        "over": {
          "type": "string",
          "enum": [
            "all",
            "optimal"
          ]
        }
      },
      "additionalProperties": false
    },
    "assigns": {
      "type": "object",
      "required": [
        "kind",
        "assignment",
        "over"
      ],
      "properties": {
        "kind": {
          "const": "assigns"
        },
        "assignment": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/valuation"
          }
        },
        "over": {
          "type": "string",
          "enum": [
            "all",
            "optimal"
          ]
        }
      },
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "required": [
        "kind",
        "literal",
        "holds"
      ],
      "properties": {
        "kind": {
          "const": "assumption"
        },
        "literal": {
          "type": "string"
        },
        "holds": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "binds": {
      "type": "object",
      "required": [
        "kind",
        "answer",
        "pattern",
        "bindings",
        "over"
      ],
      "properties": {
        "kind": {
          "const": "binds"
        },
        "answer": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown",
            "not_entailed",
            "none_holds"
          ]
        },
        "pattern": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/all"
            }
          ]
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "over": {
          "type": "string",
          "enum": [
            "all",
            "optimal"
          ]
        }
      },
      "additionalProperties": false
    },
    "blocked": {
      "type": "object",
      "required": [
        "kind",
        "rule",
        "substitution",
        "instance",
        "literal"
      ],
      "properties": {
        "kind": {
          "const": "blocked"
        },
        "rule": {
          "$ref": "#/$defs/rule"
        },
        "substitution": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "literal": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "bound": {
      "type": "object",
      "required": [
        "kind",
        "values",
        "answer",
        "taken"
      ],
      "properties": {
        "kind": {
          "const": "bound"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "answer": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown",
            "not_entailed",
            "none_holds"
          ]
        },
        "taken": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taken_at"
          }
        }
      },
      "additionalProperties": false
    },
    "census": {
      "type": "object",
      "required": [
        "kind",
        "count",
        "over"
      ],
      "properties": {
        "kind": {
          "const": "census"
        },
        "count": {
          "type": "integer"
        },
        "over": {
          "type": "string",
          "enum": [
            "all",
            "optimal"
          ]
        }
      },
      "additionalProperties": false
    },
    "child": {
      "type": "object",
      "required": [
        "kind",
        "severity",
        "message"
      ],
      "properties": {
        "kind": {
          "const": "child"
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "note",
            "help"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "chosen": {
      "type": "object",
      "required": [
        "kind",
        "rule",
        "substitution",
        "instance",
        "lower",
        "upper",
        "chosen"
      ],
      "properties": {
        "kind": {
          "const": "chosen"
        },
        "rule": {
          "$ref": "#/$defs/rule"
        },
        "substitution": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "lower": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "upper": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "chosen": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "kind",
        "reading",
        "scenario",
        "span"
      ],
      "properties": {
        "kind": {
          "const": "claim"
        },
        "reading": {
          "oneOf": [
            {
              "$ref": "#/$defs/satisfiable"
            },
            {
              "$ref": "#/$defs/census"
            },
            {
              "$ref": "#/$defs/witness"
            },
            {
              "$ref": "#/$defs/assigns"
            },
            {
              "$ref": "#/$defs/entails"
            },
            {
              "$ref": "#/$defs/costs"
            },
            {
              "$ref": "#/$defs/asks"
            },
            {
              "$ref": "#/$defs/binds"
            }
          ]
        },
        "scenario": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assumption"
          }
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      },
      "additionalProperties": false
    },
    "costs": {
      "type": "object",
      "required": [
        "kind",
        "cost"
      ],
      "properties": {
        "kind": {
          "const": "costs"
        },
        "cost": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false
    },
    "counterexample": {
      "type": "object",
      "required": [
        "kind",
        "answer_set",
        "index",
        "read"
      ],
      "properties": {
        "kind": {
          "const": "counterexample"
        },
        "answer_set": {
          "$ref": "#/$defs/answer_set"
        },
        "index": {
          "type": "integer"
        },
        "read": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "derived": {
      "type": "object",
      "required": [
        "kind",
        "rule",
        "substitution",
        "instance",
        "conditions"
      ],
      "properties": {
        "kind": {
          "const": "derived"
        },
        "rule": {
          "$ref": "#/$defs/rule"
        },
        "substitution": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "kind",
        "span",
        "severity",
        "message"
      ],
      "properties": {
        "kind": {
          "const": "diagnostic"
        },
        "span": {
          "oneOf": [
            {
              "$ref": "#/$defs/span"
            },
            {
              "type": "null"
            }
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "note",
            "help"
          ]
        },
        "message": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/child"
          }
        },
        "code": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reserved; unused in schema 1."
        }
      },
      "additionalProperties": false
    },
    "ended": {
      "type": "object",
      "required": [
        "kind",
        "cut",
        "optimum_unproven"
      ],
      "properties": {
        "kind": {
          "const": "ended"
        },
        "cut": {
          "type": "string",
          "enum": [
            "max_answer_sets",
            "max_seconds",
            "interrupted"
          ]
        },
        "optimum_unproven": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "entails": {
      "type": "object",
      "required": [
        "kind",
        "mode",
        "literals",
        "over"
      ],
      "properties": {
        "kind": {
          "const": "entails"
        },
        "mode": {
          "type": "string",
          "enum": [
            "cautious",
            "brave"
          ]
        },
        "literals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "over": {
          "type": "string",
          "enum": [
            "all",
            "optimal"
          ]
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "kind",
        "source",
        "result"
      ],
      "properties": {
        "kind": {
          "const": "entry"
        },
        "source": {
          "type": "string"
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/report"
            },
            {
              "$ref": "#/$defs/fault"
            },
            {
              "$ref": "#/$defs/internal"
            }
          ]
        },
        "libraries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "explanation": {
      "type": "object",
      "required": [
        "kind",
        "counterexample",
        "roots",
        "nodes",
        "minimality",
        "max_depth",
        "complete"
      ],
      "properties": {
        "kind": {
          "const": "explanation"
        },
        "counterexample": {
          "$ref": "#/$defs/counterexample"
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "minimality": {
          "type": "string",
          "enum": [
            "none"
          ]
        },
        "max_depth": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string",
              "enum": [
                "all"
              ]
            }
          ]
        },
        "complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": [
        "kind",
        "rule"
      ],
      "properties": {
        "kind": {
          "const": "fact"
        },
        "rule": {
          "$ref": "#/$defs/rule"
        }
      },
      "additionalProperties": false
    },
    "fault": {
      "type": "object",
      "required": [
        "kind",
        "locus",
        "diagnostics"
      ],
      "properties": {
        "kind": {
          "const": "fault"
        },
        "locus": {
          "type": "string",
          "enum": [
            "program",
            "request"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "kind",
        "claim",
        "verdict",
        "detail"
      ],
      "properties": {
        "kind": {
          "const": "finding"
        },
        "claim": {
          "$ref": "#/$defs/claim"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "undecided"
          ]
        },
        "detail": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ended"
            }
          ]
        },
        "evidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/explanation"
            },
            {
              "$ref": "#/$defs/these"
            },
            {
              "$ref": "#/$defs/not_these"
            },
            {
              "$ref": "#/$defs/no_assumptions"
            },
            {
              "$ref": "#/$defs/outranked"
            },
            {
              "$ref": "#/$defs/ended"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "internal": {
      "type": "object",
      "required": [
        "kind",
        "error_type",
        "message"
      ],
      "properties": {
        "kind": {
          "const": "internal"
        },
        "error_type": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "no_assumptions": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "no_assumptions"
        }
      },
      "additionalProperties": false
    },
    "no_rule": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "no_rule"
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "kind",
        "handle",
        "atom",
        "holds",
        "reason",
        "children"
      ],
      "properties": {
        "kind": {
          "const": "node"
        },
        "handle": {
          "type": "string"
        },
        "atom": {
          "type": "string"
        },
        "holds": {
          "type": "boolean"
        },
        "reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/fact"
            },
            {
              "$ref": "#/$defs/derived"
            },
            {
              "$ref": "#/$defs/chosen"
            },
            {
              "$ref": "#/$defs/not_chosen"
            },
            {
              "$ref": "#/$defs/aggregate"
            },
